APP_ENV=development
DATABASE_URL=sqlite:///./data/varshiq.db
# Docker/production: postgresql+psycopg://varshiq:${POSTGRES_PASSWORD}@db:5432/varshiq
POSTGRES_PASSWORD=
SERVER_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
PILOT_LOCALITY=Chhatrapati Sambhajinagar
PILOT_LATITUDE=19.8762
PILOT_LONGITUDE=75.3433
PILOT_TIMEZONE=Asia/Kolkata
OPEN_METEO_ENABLED=true
OPEN_METEO_COMMERCIAL=false
OPEN_METEO_API_KEY=
FORECAST_CACHE_MINUTES=30
REFRESH_INTERVAL_SECONDS=1800
RAIN_EVENT_DRY_GAP_HOURS=6
OSM_ENABLED=true
OVERPASS_URL=https://overpass-api.de/api/interpreter
GEOCODING_ENABLED=true
GEOCODING_PROVIDER=photon
GEOCODING_BASE_URL=
GEOCODING_USER_AGENT=VARSHIQ/0.1 (https://github.com/Gauravwakle96/VARSHIQ)
# Public Nominatim requires an informed operator decision; read docs/LOCATION_DATA.md.
GEOCODING_NOMINATIM_POLICY_ACCEPTED=false
MICROSOFT_ENABLED=false
MICROSOFT_INDEX_URL=https://bfppub.blob.core.windows.net/%24web/2026-08-13/dataset-links.csv
MICROSOFT_TILE_MAX_BYTES=52428800
IMD_ENABLED=false
IMD_API_KEY=
IMD_REQUEST_HEADERS={}
IMD_APPROVED_DATA_DIR=
IMD_DATA_TERMS_ACCEPTED=false
GOBS_ENABLED=false
GROUNDWATER_APPROVED_FILE=
SOIL_APPROVED_FILE=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
UPLOAD_MAX_BYTES=5242880
ERROR_MONITORING_DSN=
